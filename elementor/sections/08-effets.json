{"content":[{"id":"re00002","elType":"container","settings":{"content_width":"full","boxed_width":{"unit":"px","size":1180,"sizes":[]},"width":{"unit":"%","size":100,"sizes":[]},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"_element_id":"effets-rucher"},"elements":[{"id":"re00001","elType":"widget","widgetType":"html","settings":{"html":"<style>\n/* En-tete colle au defilement. position:sticky garde l'element dans le\n   flux : aucun decalage a compenser, contrairement a position:fixed. */\n.rdl-nav{position:sticky;top:0;\n  -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);}\n\n/* Cartes de miel en hexagone, comme sur le site actuel. */\n.rdl-hexcard{\n  clip-path:polygon(8% 0,92% 0,100% 50%,92% 100%,8% 100%,0 50%);\n  transition:transform .4s ease,border-color .4s ease;}\n.rdl-hexcard:hover{transform:translateY(-6px);border-color:#DC9F2E!important;}\n@media(max-width:900px){\n  .rdl-hexcard{clip-path:none;border-radius:6px;}\n}\n\n/* Les trois calques de la lampe torche. */\n#rdl-hexfield,#rdl-vignette,#rdl-glow{position:fixed;inset:0;\n  pointer-events:none;}\n#rdl-hexfield{z-index:1;opacity:.5;background-repeat:repeat;\n  background-size:52px 90px;background-image:url(\"data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%2752%27%20height%3D%2790%27%3E%3Cg%20fill%3D%27none%27%20stroke%3D%27rgba%28220%2C159%2C46%2C0.35%29%27%20stroke-width%3D%271%27%3E%3Cpolygon%20points%3D%2726%2C2%2047%2C15%2047%2C42%2026%2C55%205%2C42%205%2C15%27%2F%3E%3Cpolygon%20points%3D%270%2C47%2021%2C60%2021%2C87%200%2C100%20-21%2C87%20-21%2C60%27%2F%3E%3Cpolygon%20points%3D%2752%2C47%2073%2C60%2073%2C87%2052%2C100%2031%2C87%2031%2C60%27%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E\");}\n#rdl-vignette{z-index:1;background:radial-gradient(circle 460px at\n  var(--rdl-x,50%) var(--rdl-y,50%),transparent 0%,rgba(0,0,0,.35) 75%);}\n#rdl-glow{z-index:3;mix-blend-mode:screen;transition:opacity .4s ease;\n  background:radial-gradient(circle 380px at var(--rdl-x,50%)\n  var(--rdl-y,50%),rgba(220,159,46,.45),rgba(220,159,46,.10) 40%,\n  transparent 70%);}\n/* Sans pointeur a suivre, le halo resterait fige au centre. */\n@media (hover:none){#rdl-glow,#rdl-vignette{display:none;}}\n</style>\n<div id=\"rdl-hexfield\"></div>\n<div id=\"rdl-vignette\"></div>\n<div id=\"rdl-glow\"></div>\n<script>\n(function(){\n  /* Dans l'editeur, trois calques fixes couvriraient le canevas. */\n  if(document.body.classList.contains('elementor-editor-active'))return;\n  if(!window.matchMedia('(hover:hover)').matches)return;\n  if(window.__rdlTorche)return;\n  window.__rdlTorche=1;\n  document.addEventListener('mousemove',function(e){\n    var r=document.documentElement.style;\n    r.setProperty('--rdl-x',e.clientX+'px');\n    r.setProperty('--rdl-y',e.clientY+'px');\n  });\n})();\n</script>"},"elements":[]}],"isInner":false}],"page_settings":[],"version":"0.4","title":"Rucher d'Elsa — 08-effets","type":"container"}
